{
  "manifest_version": 3,
  "name": "Archives Beyond",
  "version": "0.1.0",
  "description": "Synchronize D&D Beyond characters, monsters, and items directly into your Archivist campaigns.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.dndbeyond.com/*",
    "https://character-service.dndbeyond.com/*",
    "https://monster-service.dndbeyond.com/*",
    "https://api.myarchivist.ai/*",
    "https://auth-service.dndbeyond.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.dndbeyond.com/characters/*",
        "https://www.dndbeyond.com/monsters/*",
        "https://www.dndbeyond.com/magic-items/*",
        "https://www.dndbeyond.com/equipment/*"
      ],
      "js": [
        "scripts/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png"
      ],
      "matches": [
        "https://www.dndbeyond.com/*"
      ]
    }
  ]
}
